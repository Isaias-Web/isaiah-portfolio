# Example only. Never commit actual keys.
# Set these values in Vercel Project > Settings > Environment Variables.
# Both switches must be true to enable the form.
CONTACT_ENABLED=false
NEXT_PUBLIC_CONTACT_ENABLED=false

# Resend: sender must be on a verified domain (cannot use arbitrary Gmail as From).
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfolio Isaías <contacto@isaiasfrutos.dev>
# Destination is deliberately fixed in src/app/api/contact/route.ts:
# isaiahweb333@gmail.com

# Cloudflare Turnstile: create a widget for isaiasfrutos.dev; keys differ.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional exact origins for additional custom preview addresses (comma-separated).
CONTACT_ALLOWED_ORIGINS=
